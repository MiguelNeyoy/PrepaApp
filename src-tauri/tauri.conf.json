{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "APP Titulación",
  "version": "0.0.1",
  "identifier": "com.apptitulacion.desktop",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "APP Titulación",
        "width": 860,
        "height": 540,
        "minWidth": 860,
        "minHeight": 540,
        "center": true,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "backgroundColor": "#f4f6fa"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
